# Double H Consulting — server configuration
# Copy to .env (or export in your process manager) before going live.

# ── Port the Express API listens on (also serves the built React app) ──
PORT=3001

# ── Admin account ─────────────────────────────────────────────────────
# Used ONLY on the first run, when the admin row is created.
# With NODE_ENV=production and no ADMIN_PASSWORD, a strong random
# password is generated and printed to the console exactly once.
ADMIN_EMAIL=admin@doubleh.com
ADMIN_PASSWORD=

# ── Production flag ───────────────────────────────────────────────────
# Enables the random-password seed path above.
NODE_ENV=production

# ── Reverse proxy ─────────────────────────────────────────────────────
# Set to the number of proxies in front of the app (1 for nginx) so the
# rate limiter sees the real client IP instead of the proxy address.
# Leave at 0 when the server is exposed directly.
TRUST_PROXY=0
